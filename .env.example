# Copy to .env (or set these in your host's dashboard) and restart.
# These only take effect on FIRST run, when data/admins.json is created.

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Port the server listens on
PORT=3000

# Secret used to sign session cookies. If omitted, one is generated and
# saved to data/.session-secret automatically.
# SESSION_SECRET=your-long-random-string

# Set to "production" on a live host, and TRUST_PROXY=1 if behind HTTPS proxy
# (Render, Railway, Fly, Nginx…) so secure cookies work.
# NODE_ENV=production
# TRUST_PROXY=1
